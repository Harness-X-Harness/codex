{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ThreadWorkflow": {
      "properties": {
        "createdAt": {
          "format": "int64",
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "pendingInstruction": {
          "type": [
            "string",
            "null"
          ]
        },
        "result": true,
        "runId": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/ThreadWorkflowStatus"
        },
        "threadId": {
          "type": "string"
        },
        "updatedAt": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "createdAt",
        "name",
        "result",
        "runId",
        "status",
        "threadId",
        "updatedAt"
      ],
      "type": "object"
    },
    "ThreadWorkflowStatus": {
      "enum": [
        "active",
        "paused",
        "complete",
        "waiting"
      ],
      "type": "string"
    }
  },
  "properties": {
    "threadId": {
      "type": "string"
    },
    "workflow": {
      "$ref": "#/definitions/ThreadWorkflow"
    }
  },
  "required": [
    "threadId",
    "workflow"
  ],
  "title": "ThreadWorkflowUpdatedNotification",
  "type": "object"
}