{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ThreadWorkflow": {
      "properties": {
        "createdAt": {
          "format": "int64",
          "type": "integer"
        },
        "currentStepIndex": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "runId": {
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/ThreadWorkflowStatus"
        },
        "steps": {
          "items": {
            "$ref": "#/definitions/ThreadWorkflowStep"
          },
          "type": "array"
        },
        "threadId": {
          "type": "string"
        },
        "updatedAt": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "createdAt",
        "currentStepIndex",
        "name",
        "runId",
        "status",
        "steps",
        "threadId",
        "updatedAt"
      ],
      "type": "object"
    },
    "ThreadWorkflowStatus": {
      "enum": [
        "active",
        "paused",
        "complete"
      ],
      "type": "string"
    },
    "ThreadWorkflowStep": {
      "properties": {
        "id": {
          "type": "string"
        },
        "instruction": {
          "type": "string"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "instruction",
        "title"
      ],
      "type": "object"
    }
  },
  "properties": {
    "threadId": {
      "type": "string"
    },
    "workflow": {
      "$ref": "#/definitions/ThreadWorkflow"
    }
  },
  "required": [
    "threadId",
    "workflow"
  ],
  "title": "ThreadWorkflowUpdatedNotification",
  "type": "object"
}